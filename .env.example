# Copy to .env.local and fill in. Get values from the Supabase dashboard or MCP.
SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Service-role key (server-side only — never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=xxx

# Vector bucket + index names (alpha feature; optional).
VECTOR_BUCKET=embeddings
VECTOR_INDEX=docs-1536
